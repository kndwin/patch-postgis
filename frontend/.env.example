# Mapbox GL JS access token (required)
# Sign up / create a public token at https://account.mapbox.com/
# This must be a public token (starts with "pk."), not a secret token.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_public_token_here

# Optional immutable PMTiles archive on an HTTP Range-capable CDN. When unset,
# the frontend uses the local/proxied Railway /tiles/{z}/{x}/{y}.mvt endpoint.
# VITE_CADASTRE_PMTILES_URL=https://tiles.example.com/nsw-cadastre-20260801.pmtiles
