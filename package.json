{
  "name": "patch-postgis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "oxfmt --write .",
    "infra:dev:plan": "bun alchemy plan infra/dev/cloudflare.ts --stage dev",
    "infra:dev:apply": "bun alchemy deploy infra/dev/cloudflare.ts --stage dev",
    "infra:prod:plan": "bun alchemy plan infra/prod/cloudflare.ts --stage prod",
    "infra:prod:apply": "bun alchemy deploy infra/prod/cloudflare.ts --stage prod",
    "infra:prod:railway:plan": "railway-iac-ts plan --file infra/prod/railway.ts",
    "infra:prod:railway:apply": "railway-iac-ts apply --file infra/prod/railway.ts",
    "infra:cloudflare:plan": "pnpm infra:prod:plan",
    "infra:cloudflare:apply": "pnpm infra:prod:apply",
    "infra:cloudflare:email:plan": "pnpm infra:dev:plan",
    "infra:cloudflare:email:apply": "pnpm infra:dev:apply",
    "infra:cloudflare:email:test": "node scripts/test-email-worker.mjs"
  },
  "dependencies": {
    "postal-mime": "^2.7.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "@effect/platform-node": "4.0.0-beta.102",
    "alchemy": "2.0.0-beta.67",
    "effect": "4.0.0-beta.102",
    "oxfmt": "0.57.0",
    "portless": "^0.15.5"
  },
  "packageManager": "pnpm@10.33.4"
}
