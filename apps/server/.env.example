DATABASE_URL=postgres://postgres:postgres@localhost:5432/patch_postgis

# Path to the cadastre FileGDB directory.  The sync CLI will use this
# path when it is set; otherwise it falls back to the newest *.gdb
# directory found under ~/Downloads.
# CADASTRE_FILEGDB_PATH=/data/NSW_Cadastre.gdb

PORT=3000

# Bearer token required by the manual cadastre workflow trigger endpoint
# CADASTRE_WORKFLOW_TRIGGER_TOKEN=

# Cadastre export provider configuration
# CADASTRE_EXPORT_EMAIL=operator@example.com
# CADASTRE_EXPORT_API_URL=https://portal.spatial.nsw.gov.au/api/exportcontent
# CADASTRE_EXPORT_SERVICE_URL=https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Land_Parcel_Property_Theme_multiCRS/FeatureServer
# CADASTRE_EXPORT_FORMAT=FILEGDB
# CADASTRE_EXPORT_DATUM=GDA2020
# CADASTRE_EXPORT_COORDINATE_SYSTEM=Geographic
# CADASTRE_EXPORT_SELECTION_GEOMETRY='{"type":"Polygon","coordinates":[[[140.09261760059334,-38.82778924088004],[140.09261760059334,-26.83199543618797],[159.98913929139331,-26.83199543618797],[159.98913929139331,-38.82778924088004],[140.09261760059334,-38.82778924088004]]]}'
