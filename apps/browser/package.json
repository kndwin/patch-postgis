{
  "name": "@patch/browser",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "VITE_API_URL=https://api.localhost portless browser -- vite",
    "dev:mock": "VITE_API_URL=https://api.localhost VITE_MOCK_SYNC=true portless --force browser -- vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "bun run lint:plugin && oxlint --type-aware src",
    "lint:plugin": "bun build src/module-state.lint.ts --outfile .cache/module-state.lint.js --target node",
    "check": "pnpm lint && pnpm typecheck && oxfmt --check .",
    "test": "bun test",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@effect/atom-react": "4.0.0-beta.107",
    "@fontsource-variable/inter": "^5.3.0",
    "@patch/http-contract": "workspace:*",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.132.0",
    "@typeonce/effect-machine": "0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "effect": "4.0.0-beta.107",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "mapbox-gl": "^3.27.0",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.23",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/bun": "latest",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "effect-oxlint": "^0.2.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.0",
    "tailwindcss": "^4.1.11",
    "typescript": "7.0.2",
    "vite": "^7.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
